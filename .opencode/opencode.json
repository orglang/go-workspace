{
  "$schema": "https://opencode.ai/config.json",
  "username": "dev",
  "instructions": ["AGENTS.md"],
  "lsp": {
    "enabled": true,
    "languages": {
      "go": {
        "enabled": true,
        "server": "gopls",
        "settings": {
          "gopls": {
            "analyses": {
              "unusedparams": true,
              "shadow": true
            },
            "staticcheck": true
          }
        }
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "lsp": "allow",
    "edit": "ask",
    "bash": { "git *": "allow", "*": "ask" }
  }
}
