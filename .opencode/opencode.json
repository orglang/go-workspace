{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "lsp": {
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": {
      "**/AGENTS.md": "ask",
      "**/taskfile*": "ask"
    },
    "bash": {
      "go generate*": "ask",
      "go run*": "ask",

      "git mv*": "allow",
      "git restore*": "ask",

      "mv*": "ask",

      "task sources": "allow",
      "task sources *": "allow",
      "task binaries": "allow",
      "task binaries *": "allow",
      "task engine:sources": "allow",
      "task engine:binaries": "allow",
      "task engine:tests:unit": "allow",
      "task engine:tests:it": "allow",

      "psql*": "ask",
      "docker buildx bake*": "ask",
      "task distros*": "ask",
      "task stack:*": "ask",
      "task stand:*": "ask",
      "task engine:tests:e2e": "ask",

      "docker compose*": "ask"
    }
  }
}